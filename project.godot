; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="放置-肉鸽-山海经"
run/main_scene="res://ui/pages/PageBattle.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/EventBus.gd"
ConfigService="*res://autoload/ConfigService.gd"
GameSettings="*res://autoload/GameSettings.gd"
InventoryModel="*res://autoload/InventoryModel.gd"
EquipmentModel="*res://autoload/EquipmentModel.gd"

[display]

window/size/viewport_width=758
window/size/viewport_height=1920
window/dpi/allow_hidpi=true
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="mobile"
